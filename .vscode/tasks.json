{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure FreeRTOS",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "local"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: Configure NoRTOS",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "local-no-rtos"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: Build",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "local"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "CMake: Build NoRTOS",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "local-no-rtos"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "OpenOCD: Probe CMSIS-DAP",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "local",
                "--target",
                "probe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "OpenOCD: Flash CMSIS-DAP",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "local",
                "--target",
                "flash"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "CMake: Build"
            ],
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "OpenOCD: Erase CMSIS-DAP",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "local",
                "--target",
                "erase"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "OpenOCD: Probe XDS110",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "local",
                "--target",
                "probe-xds110"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "OpenOCD: Flash XDS110",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "local",
                "--target",
                "flash-xds110"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "CMake: Build"
            ],
            "problemMatcher": "$gcc"
        },
        {
            "label": "OpenOCD: Erase XDS110",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "local",
                "--target",
                "erase-xds110"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}

{
    "version":  "2.0.0",
    "tasks":  [
                  {
                      "label":  "CMake: Configure FreeRTOS",
                      "type":  "shell",
                      "command":  "cmake",
                      "args":  [
                                   "-S",
                                   "${workspaceFolder}",
                                   "-B",
                                   "${workspaceFolder}/build",
                                   "-G",
                                   "Ninja",
                                   "-DUSE_FREERTOS=ON"
                               ],
                      "options":  {
                                      "cwd":  "${workspaceFolder}",
                                      "shell":  {
                                                    "executable":  "cmd.exe",
                                                    "args": ["/c"]
                                                }
                                  },
                      "problemMatcher":  [

                                         ]

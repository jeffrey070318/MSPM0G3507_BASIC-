{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "MSPM0G3507 Default",
            "description": "Configure with FreeRTOS",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/arm-none-eabi-gcc.cmake",
                "USE_FREERTOS": "ON"
            }
        },
        {
            "name": "no-rtos",
            "displayName": "MSPM0G3507 NoRTOS",
            "description": "Configure without FreeRTOS",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build-nortos",
            "cacheVariables": {
                "USE_FREERTOS": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "displayName": "Build MSPM0G3507"
        },
        {
            "name": "no-rtos",
            "configurePreset": "no-rtos",
            "displayName": "Build MSPM0G3507 NoRTOS"
        }
    ]
}

{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "MSPM0G3507 Default",
            "description": "Configure with FreeRTOS",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/arm-none-eabi-gcc.cmake",
                "USE_FREERTOS": "ON"
            }
        },
        {
            "name": "no-rtos",
            "displayName": "MSPM0G3507 NoRTOS",
            "description": "Configure without FreeRTOS",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build-nortos",
            "cacheVariables": {
                "USE_FREERTOS": "OFF"
            }
        },
        {
            "name": "local",
            "displayName": "MSPM0G3507 Local",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_MAKE_PROGRAM": "D:/Toolchain/ninja-win/ninja.exe",
                "MSPM0_SDK_DIR": "D:/CCSToolchain/mspm0_sdk_2_09_00_01",
                "SYSCONFIG_CLI": "D:/CCSToolchain/sysconfig/sysconfig_cli.bat",
                "OPENOCD_EXE": "D:/Toolchain/xpack-openocd-0.12.0-7-win32-x64/xpack-openocd-0.12.0-7/bin/openocd.exe",
                "OPENOCD_SCRIPTS_DIR": "D:/Toolchain/xpack-openocd-0.12.0-7-win32-x64/xpack-openocd-0.12.0-7/openocd/scripts"
            },
            "environment": {
                "PATH": "D:/Toolchain/arm-gnu-toolchain-14.3.rel1-mingw-w64-x86_64-arm-none-eabi/bin;D:/Toolchain/ninja-win;$penv{PATH}"
            }
        },
        {
            "name": "local-no-rtos",
            "displayName": "MSPM0G3507 Local NoRTOS",
            "inherits": "no-rtos",
            "cacheVariables": {
                "CMAKE_MAKE_PROGRAM": "D:/Toolchain/ninja-win/ninja.exe",
                "MSPM0_SDK_DIR": "D:/CCSToolchain/mspm0_sdk_2_09_00_01",
                "SYSCONFIG_CLI": "D:/CCSToolchain/sysconfig/sysconfig_cli.bat",
                "OPENOCD_EXE": "D:/Toolchain/xpack-openocd-0.12.0-7-win32-x64/xpack-openocd-0.12.0-7/bin/openocd.exe",
                "OPENOCD_SCRIPTS_DIR": "D:/Toolchain/xpack-openocd-0.12.0-7-win32-x64/xpack-openocd-0.12.0-7/openocd/scripts"
            },
            "environment": {
                "PATH": "D:/Toolchain/arm-gnu-toolchain-14.3.rel1-mingw-w64-x86_64-arm-none-eabi/bin;D:/Toolchain/ninja-win;$penv{PATH}"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "displayName": "Build MSPM0G3507"
        },
        {
            "name": "no-rtos",
            "configurePreset": "no-rtos",
            "displayName": "Build MSPM0G3507 NoRTOS"
        },
        {
            "name": "local",
            "configurePreset": "local",
            "displayName": "Build MSPM0G3507 Local"
        },
        {
